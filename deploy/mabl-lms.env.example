# Окружение сервиса МАБЛ LMS на VM.
#
# На чистой машине файл создаёт deploy/bootstrap.sh: он сам подставляет пароль
# локальной БД и генерирует секреты. Вручную:
#   sudo cp deploy/mabl-lms.env.example /etc/mabl-lms.env
#   sudo chown root:root /etc/mabl-lms.env && sudo chmod 600 /etc/mabl-lms.env
#   sudo nano /etc/mabl-lms.env      # подставить реальные значения
#   sudo systemctl restart mabl-lms
#
# Формат — KEY=VALUE без кавычек и без `export` (это EnvironmentFile systemd).

# ---------- сервер ----------
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Потолок размера одного загружаемого файла (МБ). Должен совпадать с
# client_max_body_size в конфиге nginx.
MAX_UPLOAD_MB=256

# ---------- база данных (PostgreSQL) ----------
# По умолчанию — PostgreSQL на этой же машине: слушает только localhost,
# поэтому TLS не нужен (sslmode=disable). Пароль — только [0-9a-f], чтобы его
# не пришлось экранировать в URL; bootstrap.sh генерирует его сам.
DATABASE_URL=postgresql://mabl:ПАРОЛЬ@127.0.0.1:5432/mabl?sslmode=disable
# Внешний управляемый кластер (если появится): sslmode=verify-full и корневой
# сертификат провайдера в DATABASE_CA_FILE.
# DATABASE_URL=postgresql://mabl:ПАРОЛЬ@db.example:6432/mabl?sslmode=verify-full
# DATABASE_CA_FILE=/etc/ssl/certs/provider-root.crt
# Выключить TLS к БД, не трогая DATABASE_URL (на PaaS его подставляет
# платформа): DATABASE_SSL=disable.
# DATABASE_SSL=disable
# Размер пула соединений (по умолчанию 10).
# DATABASE_POOL_MAX=10

# ---------- файловое хранилище ----------
# Файлы SCORM-пакетов и материалов лежат либо на диске этой машины, либо в
# S3-совместимом хранилище. Выбор — по наличию S3_BUCKET.
#
# ВАРИАНТ 1 (по умолчанию): диск машины. Ничего настраивать не нужно, внешних
# ключей не требуется. Каталог по умолчанию — storage в рабочем каталоге
# сервиса (/srv/mabl-lms/storage); он не отслеживается git и переживает деплой.
# Задайте STORAGE_DIR, чтобы положить файлы на отдельный диск.
# STORAGE_DIR=/srv/mabl-lms/storage
#
# ВАРИАНТ 2: S3-совместимое хранилище (Yandex Object Storage и аналоги). Нужен, когда машин несколько или файлы
# должны пережить пересоздание VM. Достаточно РАСКОММЕНТИРОВАТЬ строки ниже и
# заполнить их — заданный S3_BUCKET сам переключает приложение на хранилище.
# Ключ берётся у сервисного аккаунта с ролью storage.editor.
# Внимание: переключение бэкенда файлы НЕ переносит — пакеты придётся залить
# заново через админку.
# S3_BUCKET=mabl-lms-files
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- аутентификация ----------
# Секрет подписи токенов сессии. Сгенерировать: openssl rand -hex 32
# ВАЖНО: при переустановке сервера перенесите прежнее значение — иначе все
# активные сессии слетят и слушателям придётся входить заново.
AUTH_SECRET=

# ---------- стартовый администратор ----------
# Учитывается только при инициализации БД, если такого e-mail ещё нет.
ADMIN_EMAIL=admin@mabl.ru
ADMIN_PASSWORD=

# ---------- одноразовая инициализация БД ----------
# POST /api/setup?secret=... — создаёт таблицы и аккаунт администратора.
SETUP_SECRET=

# ---------- ЮKassa ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Базовый URL для возврата после оплаты. Пусто — берётся SITE_URL.
YOOKASSA_RETURN_URL=

# ---------- Telegram ----------
# Публичный канал академии, из которого подтягиваются новости.
TELEGRAM_CHANNEL=mabl_academy

# Ключ для вызова синхронизации новостей по GET. Таймер systemd шлёт его в
# заголовке Authorization; без ключа маршрут открыт всем и защищён только
# ограничением частоты.
CRON_SECRET=

# ---------- собственный домен ----------
# Канонический адрес сайта: подставляется в ссылки писем и return_url оплаты,
# а также разрешает CORS для собственного фронтенда. Это адрес самой
# платформы, а не главного сайта академии: с mabl.ru ссылки сброса пароля и
# возврат после оплаты уводили бы на чужой сайт.
SITE_URL=https://course.mabl.ru
# Дополнительные доверенные домены через запятую (например, тестовый).
ALLOWED_HOSTS=

# ---------- резервные копии (deploy/backup.sh) ----------
# Каталог и срок хранения локальных копий: дампы БД — 14 дней, архивы
# файлового хранилища — 3 дня (они крупные).
# BACKUP_DIR=/var/backups/mabl
# BACKUP_KEEP_DAYS=14
# BACKUP_STORAGE_KEEP_DAYS=3
# Копия ВНЕ этой машины: rsync по SSH (ключ root → удалённый хост). Без неё
# бэкапы умирают вместе с машиной — именно так и потерялся прошлый сервер.
# BACKUP_RSYNC_TARGET=backup@backup.example:/backups/mabl-lms/

# ---------- почта ----------
# Транспорт выбирается по заданным переменным: SMTP имеет приоритет над Resend.
# Многие VPS-провайдеры по умолчанию закрывают исходящие 25/465/587 —
# проверьте до запуска (DEPLOY.md, раздел «Проверки сети»).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
# Либо API-ключ Resend вместо SMTP.
RESEND_API_KEY=
# Адрес отправителя: Академия МАБЛ <noreply@mabl.ru>
MAIL_FROM=
